{
  "manifest_version": 3,
  "name": "ChatGPT Usage Tracker",
  "version": "1.4.1",
  "description": "Show 5-hour and weekly Codex / Work usage from ChatGPT's own usage requests.",
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "page-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "usage.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Usage Tracker"
  }
}
